---
// src/components/Confirmacion.astro
// El ramo de lirios (florcentro.png), "Confirma tu Asistencia" en Great
// Vibes dorada, un separador, el saludo con tres párrafos y un
// solo botón dorado con el ícono de WhatsApp. El botón abre el chat con el
// mensaje ya escrito, así el invitado solo tiene que tocar "enviar".

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = ["Confirma tu", "Asistencia"];
// El saludo y los párrafos, como en la despedida pero para el bautizo
const saludo = "Querida familia y amigos";
const parrafos = [
    "Nos llena de felicidad poder compartir con ustedes el día de mi bautizo, un momento tan especial.",
    "Con la esperanza de que hagamos de este día un recuerdo inolvidable.",
    "Los esperamos con el corazón lleno de alegría, listos para celebrar con amor y crear memorias que permanezcan por siempre.",
];
const textoBoton = "Confirmar asistencia";

// Número con código de país, sin + ni espacios (Bolivia: 591)
const whatsapp = "59172711936";
const mensaje =
    "¡Hola! Me complace confirmar mi asistencia al bautizo de Eithan, " +
    "que se realizará el sábado 31 de octubre. ¡Estaré sin falta! " +
    "Muchas gracias.";
// ──────────────────────────────────────────────────────────────

const enlace = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
---

<section id="confirmacion" class="seccion">
    <div id="bloque-confirmacion" class="bloque">
        <img
            src="/imagenes/florcentro.png"
            alt=""
            width="1071"
            height="531"
            aria-hidden="true"
            class="flores"
        />

        <p class="titulo">{titulo.map((r) => <span>{r}</span>)}</p>

        <!-- Separador: raya · rombo · raya -->
        <div class="separador" aria-hidden="true">
            <span class="raya"></span>
            <span class="rombo"></span>
            <span class="raya"></span>
        </div>

        <div class="frase">
            <p class="saludo">{saludo}</p>
            {parrafos.map((p) => <p class="parrafo">{p}</p>)}
        </div>

        <a
            class="boton"
            href={enlace}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Confirmar asistencia por WhatsApp"
        >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                    d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91A9.86 9.86 0 0 0 12.04 2zm0 18.15h-.01a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"
                ></path>
            </svg>
            {textoBoton}
        </a>
    </div>
</section>

<style>
    .seccion {
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 12% 0;
        background-image: linear-gradient(#ffffff, #ffffff);
    }

    .bloque {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 8cqw;
    }

    /* Great Vibes, sin mayúsculas forzadas ni espaciado: no los tolera */
    .titulo {
        margin-top: 4cqw;
        display: flex;
        flex-direction: column;
        font-family: "Great Vibes", cursive;
        font-size: 13cqw;
        line-height: 1.05;
        color: #b8742a;
    }

    .flores {
        display: block;
        width: 42cqw;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ── Separador: raya · rombo · raya, en dorado ── */
    .separador {
        margin-top: 6cqw;
        display: flex;
        align-items: center;
        gap: 3cqw;
    }
    .raya {
        display: block;
        width: 18cqw;
        height: 1px;
        background-image: linear-gradient(90deg, transparent, #c07d2c);
    }
    .raya:last-child {
        background-image: linear-gradient(90deg, #c07d2c, transparent);
    }
    .rombo {
        display: block;
        width: 2cqw;
        height: 2cqw;
        border: 1px solid #c07d2c;
        transform: rotate(45deg);
    }

    /* El saludo y los párrafos, derechos y en marrón cálido */
    .frase {
        margin-top: 5cqw;
        max-width: 74cqw;
        font-family: "Cormorant Garamond", "Times New Roman", serif;
        font-weight: 600;
        font-size: 4.8cqw;
        line-height: 1.55;
        color: #5a3f22;
    }

    /* Great Vibes, sin mayúsculas forzadas ni espaciado: no los tolera */
    .saludo {
        font-family: "Great Vibes", cursive;
        font-weight: 400;
        font-size: 8.5cqw;
        line-height: 1.2;
        color: #b8742a;
    }

    .parrafo {
        margin-top: 3.5cqw;
    }

    /*
       Botón dorado con un filo blanco por dentro y un brillo que lo
       cruza cada tanto, para que invite a tocarlo.
    */
    .boton {
        position: relative;
        overflow: hidden;
        margin-top: 9cqw;
        display: inline-flex;
        align-items: center;
        gap: 2.6cqw;
        padding: 3.6cqw 6cqw;
        border-radius: 999px;
        background-image: linear-gradient(135deg, #c8873a, #b06f28);
        color: #ffffff;
        font-family: "Cormorant Garamond", "Times New Roman", serif;
        font-weight: 700;
        font-size: 4cqw;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        box-shadow:
            inset 0 0 0 1.5px rgba(255, 255, 255, 0.55),
            0 8px 18px rgba(150, 90, 30, 0.32);
        transition: transform 0.2s ease;
    }
    .boton:active {
        transform: scale(0.96);
    }
    .boton::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: -40%;
        width: 30%;
        background-image: linear-gradient(
            100deg,
            transparent,
            rgba(255, 255, 255, 0.45),
            transparent
        );
        transform: skewX(-20deg);
        animation: brillo 3.2s ease-in-out infinite;
        pointer-events: none;
    }

    @keyframes brillo {
        0%,
        55% {
            left: -40%;
        }
        100% {
            left: 130%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .boton::after {
            animation: none;
            display: none;
        }
    }
    .boton svg {
        width: 6cqw;
        height: 6cqw;
        fill: #ffffff;
        flex-shrink: 0;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-confirmacion");
        if (!bloque) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const flores = bloque.querySelector(".flores");
        const separador = bloque.querySelector(".separador");
        const renglones = bloque.querySelectorAll(".titulo span");
        const frase = bloque.querySelectorAll(".frase > p");
        const boton = bloque.querySelector(".boton");

        gsap.timeline({
            scrollTrigger: {
                trigger: bloque,
                start: "top 82%",
                toggleActions: "play none none reset",
            },
        })
            // El ramo se abre desde abajo
            .fromTo(
                flores,
                { opacity: 0, scale: 0.85, y: 20 },
                {
                    opacity: 1,
                    scale: 1,
                    y: 0,
                    duration: 1.1,
                    ease: "back.out(1.4)",
                },
            )
            // El título se escribe renglón por renglón. El recorte tiene
            // margen para no morder los rulos de la Great Vibes.
            .fromTo(
                renglones,
                { opacity: 0, clipPath: "inset(-30% 100% -30% -10%)" },
                {
                    opacity: 1,
                    clipPath: "inset(-30% -10% -30% -10%)",
                    duration: 1.1,
                    stagger: 0.5,
                    ease: "power2.inOut",
                },
                0.4,
            )
            // El separador se abre desde el centro
            .fromTo(
                separador,
                { opacity: 0, scaleX: 0.4 },
                { opacity: 1, scaleX: 1, duration: 0.8, ease: "power2.out" },
                1.2,
            )
            .fromTo(
                frase,
                { opacity: 0, y: 14 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.2,
                    ease: "power2.out",
                },
                1.3,
            )
            // El botón aparece con un rebote suave
            .fromTo(
                boton,
                { opacity: 0, scale: 0.8 },
                {
                    opacity: 1,
                    scale: 1,
                    duration: 0.7,
                    ease: "back.out(1.8)",
                },
                2.4,
            );
    });
</script>
