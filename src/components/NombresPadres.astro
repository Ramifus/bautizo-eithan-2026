---
// src/components/NombresPadres.astro
// Dos bloques iguales: "Mis Padres" y "Mis Padrinos" en Great Vibes dorada
// y, debajo de cada título, los dos nombres en mayúsculas grises.

// ── DATOS EDITABLES ───────────────────────────────────────────
const grupos = [
    {
        titulo: "Mis Padres",
        nombres: ["Otoniel Alcocer Pozo", "Lilian Brenda Salvatierra Nina"],
    },
    {
        titulo: "Mis Padrinos",
        nombres: ["Alexander Guzmán Pozo", "Shirley Zeballos Araoz"],
    },
];
// ──────────────────────────────────────────────────────────────
---

<section id="nombres-padres" class="seccion">
    <div id="bloque-padres" class="bloque">
        {
            grupos.map((g) => (
                <div class="grupo">
                    <p class="titulo">{g.titulo}</p>
                    <div class="nombres">
                        {g.nombres.map((n) => (
                            <p class="nombre">{n}</p>
                        ))}
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    .seccion {
        position: relative;
        width: 100%;
        padding: 8% 0;
        background-image: linear-gradient(#ffffff, #ffffff);
    }

    /* Con container-type, 1cqw es el 1% del ancho de la columna */
    .bloque {
        container-type: inline-size;
        width: 100%;
        text-align: center;
    }

    .grupo + .grupo {
        margin-top: 9cqw;
    }

    /* Great Vibes, sin mayúsculas forzadas ni espaciado: no los tolera */
    .titulo {
        margin: 0;
        font-family: "Great Vibes", cursive;
        font-size: 9.5cqw;
        line-height: 1.2;
        color: #c07d2c;
    }

    .nombres {
        margin-top: 4cqw;
    }

    .nombre {
        margin: 0;
        font-family: "Cormorant Garamond", "Times New Roman", serif;
        font-weight: 600;
        font-size: 4.7cqw;
        line-height: 1.5;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #4a4a4a;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const bloque = document.getElementById("bloque-padres");
        if (!bloque) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const grupos = Array.from(bloque.querySelectorAll(".grupo"));

        grupos.forEach((grupo) => {
            const titulo = grupo.querySelector(".titulo");
            const nombres = grupo.querySelectorAll(".nombre");

            const linea = gsap.timeline({
                scrollTrigger: {
                    trigger: grupo,
                    start: "top 85%",
                    toggleActions: "play none none reset",
                },
            });

            linea
                // El título se escribe de izquierda a derecha. El recorte
                // tiene margen para no morder los rulos de la Great Vibes.
                .fromTo(
                    titulo,
                    { opacity: 0, clipPath: "inset(-30% 100% -30% -10%)" },
                    {
                        opacity: 1,
                        clipPath: "inset(-30% -10% -30% -10%)",
                        duration: 1.3,
                        ease: "power2.inOut",
                    },
                )
                // Y los nombres suben uno tras otro
                .fromTo(
                    nombres,
                    { opacity: 0, y: 12 },
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: "power2.out",
                    },
                    0.5,
                );
        });
    });
</script>
